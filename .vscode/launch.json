{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Stock.Api",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Services/FlowStock.Stock/Stock.Api/bin/Debug/net10.0/Stock.Api.dll",
            "cwd": "${workspaceFolder}/src/Services/FlowStock.Stock/Stock.Api",
            "stopAtEntry": false
        },
        {
            "name": "Usermanagement.Api",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Services/FlowStock.Usermanagement/Usermanagement.Api/bin/Debug/net10.0/UserManagement.Api.dll",
            "cwd": "${workspaceFolder}/src/Services/FlowStock.Usermanagement/Usermanagement.Api",
            "stopAtEntry": false
        }
    ],
    "compounds": [
        {
            "name": "FlowStock - All Services",
            "configurations": [
                "Stock.Api",
                "Usermanagement.Api"
            ],
            "stopAll": true
        }
    ]
